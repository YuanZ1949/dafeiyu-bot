DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
BOT_QQ=10001
NAPCAT_WS_HOST=127.0.0.1
NAPCAT_WS_PORT=8080
NAPCAT_WS_TOKEN=
DAFEIYU_DB_PATH=data/dafeiyu.db
DEEPSEEK_REASONING_EFFORT=

# opencode serve 的 Basic 认证口令（P7）。通常留空：supervisor 每次启动生成随机
# 口令并同时注入 serve 与 bot；只有外部/手动跑 serve 时才需要在这里固定。
OPENCODE_SERVER_PASSWORD=

# dashboard 从本机以外访问时必填（至少 12 位）。只绑 127.0.0.1 时可以留空。
DAFEIYU_DASHBOARD_USER=admin
DAFEIYU_DASHBOARD_PASSWORD=
# 登录有效期（小时），默认 168。
DAFEIYU_DASHBOARD_SESSION_HOURS=168
